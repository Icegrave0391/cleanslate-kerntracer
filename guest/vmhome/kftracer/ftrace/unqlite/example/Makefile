	cd /home/seclog/kftracer/ftrace/unqlite && $(MAKE) $(MAKESILENT) -f example/CMakeFiles/unqlite_test_example_unqlite_tar.dir/build.make example/CMakeFiles/unqlite_test_example_unqlite_tar.dir/unqlite_tar.c.o
.PHONY : unqlite_tar.c.o

unqlite_tar.i: unqlite_tar.c.i
.PHONY : unqlite_tar.i

# target to preprocess a source file
unqlite_tar.c.i:
	cd /home/seclog/kftracer/ftrace/unqlite && $(MAKE) $(MAKESILENT) -f example/CMakeFiles/unqlite_test_example_unqlite_tar.dir/build.make example/CMakeFiles/unqlite_test_example_unqlite_tar.dir/unqlite_tar.c.i
.PHONY : unqlite_tar.c.i

unqlite_tar.s: unqlite_tar.c.s
.PHONY : unqlite_tar.s

# target to generate assembly for a file
unqlite_tar.c.s:
	cd /home/seclog/kftracer/ftrace/unqlite && $(MAKE) $(MAKESILENT) -f example/CMakeFiles/unqlite_test_example_unqlite_tar.dir/build.make example/CMakeFiles/unqlite_test_example_unqlite_tar.dir/unqlite_tar.c.s
.PHONY : unqlite_tar.c.s

